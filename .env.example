# No application secrets or wallet credentials belong in environment files.
# Preprod endpoints and trusted loopback proof URL are pinned in client modules
# and the server CSP. Choose the public escrow address in the browser workspace.
# Copy to .env.local. npm run services:* reads it before .env, like Next.js.
# Keep this Compose host port aligned with the client's loopback URL (6300).
# An alternate port requires a coordinated source/CSP/wallet configuration change.
PROOF_SERVER_PORT=6300
