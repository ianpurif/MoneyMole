# No application secrets or wallet credentials belong in environment files.
# Preprod endpoints and trusted loopback proof URL come from config/preprod.json.
# Choose the public escrow address in the browser workspace.
# Copy to .env.local. npm run services:* reads it before .env, like Next.js.
# Public issuer/endpoints live in config/preprod.json, shared by browser and CLI.
# Escrow selection is public browser storage; encrypted secrets stay in IndexedDB.
# Keep this Compose host port aligned with config/preprod.json (6300).
# An alternate port requires a coordinated source/CSP/wallet configuration change.
PROOF_SERVER_PORT=6300
