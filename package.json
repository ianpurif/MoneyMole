{
  "name": "private-payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "deps:lock": "node scripts/bootstrap.mjs --lock-only",
    "doctor": "node scripts/doctor.mjs",
    "doctor:codex": "node scripts/codex-doctor.mjs",
    "doctor:mcp": "node scripts/mcp-doctor.mjs",
    "check:offline": "node scripts/offline.mjs",
    "test:boilerplate": "node --experimental-strip-types --test tests/boilerplate/*.test.mjs",
    "verify:boilerplate": "node scripts/verify-boilerplate.mjs",
    "dev": "next dev --webpack --hostname localhost --port 3000",
    "start": "next start --hostname localhost --port 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "next build --webpack",
    "test:unit": "vitest run --project unit",
    "compile:probe": "node scripts/compile.mjs --probe",
    "compile:coin-probe": "node scripts/compile.mjs --coin-probe",
    "compile:contracts": "node scripts/compile.mjs --product",
    "compile:legacy": "node scripts/compile.mjs --legacy",
    "compile:issuance": "node scripts/compile.mjs --issuance",
    "verify:artifacts": "node scripts/product.mjs artifacts",
    "test:contracts": "node scripts/product.mjs contracts",
    "test:integration": "node scripts/product.mjs integration",
    "test:proving": "node scripts/product.mjs proving",
    "test:preprod": "node scripts/product.mjs preprod",
    "verify:product": "node scripts/product.mjs acceptance",
    "test:browser": "playwright test",
    "services:up": "node scripts/services.mjs up",
    "services:down": "node scripts/services.mjs down",
    "services:status": "node scripts/services.mjs status",
    "services:check": "node scripts/services.mjs check",
    "deploy:preprod": "node scripts/product.mjs deploy",
    "verify:deployment": "node scripts/product.mjs deployment",
    "verify:issuer": "node scripts/verify-issuer.mjs",
    "verify:connectivity": "node scripts/verify-browser-connectivity.mjs",
    "requirements:report": "node scripts/requirements.mjs --write",
    "requirements:check": "node scripts/requirements.mjs --check",
    "evidence:participants": "node scripts/participants.mjs",
    "history:inspect": "node scripts/history.mjs",
    "audit:deps": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@scure/base": "2.4.0",
    "class-variance-authority": "0.7.1",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "next": "16.3.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.3.1"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.7",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "6.2.4",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
